# Contact form email delivery (Resend — https://resend.com)
# 1. Sign up free at https://resend.com  (3,000 emails/month)
# 2. Go to API Keys -> Create API Key, copy it here
# 3. Copy this file to `.env.local` and fill in the value
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Inbox that receives the messages (optional — defaults to nikitalilhore1902@gmail.com)
CONTACT_TO_EMAIL=nikitalilhore1902@gmail.com

# Sender address (optional). "onboarding@resend.dev" works immediately but can ONLY
# deliver to the email you signed up to Resend with. To send from your own domain,
# verify it in Resend -> Domains, then use e.g. contact@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
